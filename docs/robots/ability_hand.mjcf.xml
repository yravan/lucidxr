<?xml version="1.0" ?>
<mujoco model="default stage">
  <compiler angle="radian" autolimits="true"/>
  <statistic center="0.2 0 0.4" extent=".65"/>
  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="150" elevation="-20" offwidth="1280" offheight="1024"/>
  </visual>
  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <texture type="2d" name="i-box-light_wood" file="staging/insertion-box/light_wood_planks.png"/>
    <material name="i-box-light_wood" texture="i-box-light_wood" specular="0.1" shininess="0.1" texrepeat="1 1"/>
    <mesh name="i-box-obj" file="staging/insertion-box/block.obj" scale="0.1 0.1 0.1">
      <plugin instance="i-box-sdf"/>
    </mesh>
    <texture type="2d" name="sq-block-warm_wood" file="staging/blocks/warm_wood_planks.png"/>
    <material name="sq-block-warm_wood" texture="sq-block-warm_wood" specular="0.1" shininess="0.1" texrepeat="1 1"/>
    <mesh name="sq-block-obj" file="staging/blocks/square.obj" scale="0.095 0.095 0.095"/>
    <texture type="2d" name="tr-block-warm_wood" file="staging/blocks/warm_wood_planks.png"/>
    <material name="tr-block-warm_wood" texture="tr-block-warm_wood" specular="0.1" shininess="0.1" texrepeat="1 1"/>
    <mesh name="tr-block-obj" file="staging/blocks/triangle.obj" scale="0.095 0.095 0.095"/>
    <texture type="2d" name="hx-block-warm_wood" file="staging/blocks/warm_wood_planks.png"/>
    <material name="hx-block-warm_wood" texture="hx-block-warm_wood" specular="0.1" shininess="0.1" texrepeat="1 1"/>
    <mesh name="hx-block-obj" file="staging/blocks/hex.obj" scale="0.095 0.095 0.095"/>
    <texture type="2d" name="cr-block-warm_wood" file="staging/blocks/warm_wood_planks.png"/>
    <material name="cr-block-warm_wood" texture="cr-block-warm_wood" specular="0.1" shininess="0.1" texrepeat="1 1"/>
    <mesh name="cr-block-obj" file="staging/blocks/circle.obj" scale="0.095 0.095 0.095"/>
  </asset>
  <option timestep="0.002" integrator="implicitfast" sdf_iterations="20" sdf_initpoints="40"/>
  <extension>
    <plugin plugin="mujoco.sdf.sdflib">
      <instance name="i-box-sdf">
        <config key="aabb" value="0"/>
      </instance>
    </plugin>
    <plugin plugin="mujoco.elasticity.cable"/>
  </extension>
  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>
    <body name="insertion-box" pos="0 0 0.5">
      <joint type="free"/>
      <geom type="sdf" mesh="i-box-obj" material="i-box-light_wood" contype="1" conaffinity="1">
        <plugin instance="i-box-sdf"/>
      </geom>
    </body>
    <body name="square" pos="0.5 0.5 0.5">
      <joint type="free"/>
      <geom type="mesh" mesh="sq-block-obj" material="sq-block-warm_wood"/>
    </body>
    <body name="triangle" pos="0.7 0.5 0.5">
      <joint type="free"/>
      <geom type="mesh" mesh="tr-block-obj" material="tr-block-warm_wood"/>
    </body>
    <body name="hex" pos="0.5 0.7 0.5">
      <joint type="free"/>
      <geom type="mesh" mesh="hx-block-obj" material="hx-block-warm_wood"/>
    </body>
    <body name="circle" pos="0.7 0.7 0.5">
      <joint type="free"/>
      <geom type="mesh" mesh="cr-block-obj" material="cr-block-warm_wood"/>
    </body>
    <composite type="cable" curve="sin(s) s" count="40" initial="free" offset="1 -0.5 0.7">
      <joint kind="main" damping=".05"/>
      <geom type="capsule" size=".007" rgba=".4 .4 .4 1" condim="1" mass="0.05"/>
    </composite>
  </worldbody>
</mujoco>