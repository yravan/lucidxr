      <site pos="0 0 0" name="left-middle-finger-tip-site" size="0.001" rgba="1 1 1 1"/>
    </body>

    <body mocap="true" name="left-ring-finger-tip" pos="-0.016 -0.036 0.171" quat="0.7071 0.7071 0 0">
      <site pos="0 0 0" name="left-ring-finger-tip-site" size="0.001" rgba="1 1 1 1"/>
