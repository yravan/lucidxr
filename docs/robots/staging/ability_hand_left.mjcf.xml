    </body>

    <body mocap="true" name="left-thumb-tip" pos="0.118 -0.004 0.077" quat="0.4330 0.6830 0.6830 0.1830">-->
      <site name="left-thumb-tip-site" size="0.001" rgba="1 1 1 1"/>
