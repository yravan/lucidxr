    <body mocap="true" name="left-index-finger-tip" pos="0.033 -0.036 0.173" quat="0.7071 0.7071 0 0">
      <site pos="0 0 0" name="left-index-finger-tip-site" size="0.001" rgba="1 1 1 1"/>
