      <geom type="box" size="0.02 0.02 0.02" rgba="1 0.2 0.2 1" condim="6" priority="1"
            friction="0.5 0.01 0.003"/>
    </body>

    <body name="sticky-cube-2 " pos="-0.3 -0.3 1">
      <freejoint/>
      <geom type="box" size="0.02 0.02 0.02" rgba="0.2 1 0.2 1" condim="6" priority="1"
            friction="0.5 0.01 0.003"/>
    </body>

    <body name="sticky-cube-3" pos="-0.4 -0.4 1">
      <freejoint/>
      <geom type="box" size="0.03 0.03 0.03" rgba="0.2 0.2 1 1" condim="6" priority="1"
            friction="0.5 0.01 0.003"/>
    </body>

    <body name="table" pos="-0.2 -0.2 0.8">
      <geom type="box" size="0.5 0.7 0.02" rgba="0.6 0.3 0 1"/>
    </body>

    <!-- Mocap Bodies -->
    <body mocap="true" name="left-wrist" pos="0 0 0" quat="0.7071 0.7071 0 0">
      <site pos="0 0 0" name="left-wrist-site" size="0.001" rgba="1 1 1 1"/>
