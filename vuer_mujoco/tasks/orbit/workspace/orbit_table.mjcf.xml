<?xml version="1.0" ?>
<mujoco>
  <default>
    <geom solref="0.003 1" solimp="0.95 0.99 0.001"/>
  </default>
  <default>
    <default class="optical_table-visual">
      <geom group="2" type="mesh" contype="0" conaffinity="0"/>
    </default>
    <default class="optical_table-collision">
      <geom group="3" type="mesh"/>
    </default>
  </default>
  <asset>
    <!--Materials ported from MTL file-->
    <material name="optical_table-mat_1" rgba="0.501961 0.517647 0.501961 1" roughness="0" shininess="1" specular="0.4"/>
    <material name="optical_table-mat_2" rgba="1 1 1 1" roughness="0" shininess="1" specular="0.4"/>
    <material name="optical_table-mat_3" rgba="0.752941 0.752941 0.752941 1" roughness="0" shininess="1" specular="0.4"/>
    <material name="optical_table-mat_4" rgba="0.647059 0.619608 0.588235 1" roughness="0" shininess="1" specular="0.4"/>
    <!--Good wood-like color for tabletop-->
    <material name="optical_table-mat_5" rgba="0.101961 0.101961 0.101961 1" roughness="0" shininess="1" specular="0.4"/>
    <!--Dark color for legs/structure-->
    <material name="optical_table-mat_6" rgba="0.109804 0.109804 0.109804 1" roughness="0" shininess="1" specular="0.4"/>
    <material name="optical_table-mat_7" rgba="0.792157 0.819608 0.933333 1" roughness="0" shininess="1" specular="0.4"/>
    <material name="optical_table-mat_8" rgba="0.529412 0.549020 0.549020 1" roughness="0" shininess="1" specular="0.4"/>
    <material name="optical_table-mat_9" rgba="0.098039 0.098039 0.098039 1" shininess=""/>
    <material name="optical_table-mat_10" rgba="0 0 0 1" roughness="0" shininess="1" specular="0.4"/>
    <material name="optical_table-mat_11" rgba="0.294118 0.294118 0.294118 1" roughness="0" shininess="1" specular="0.4"/>
    <material name="optical_table-mat_12" rgba="0.250980 0.250980 0.250980 1" roughness="0" shininess="1" specular="0.4"/>
    <material name="optical_table-mat_13" rgba="0.698039 0.698039 0.698039 1" roughness="0" shininess="1" specular="0.4"/>
    <material name="optical_table-mat_14" rgba="0.956863 0.956863 0.956863 1" roughness="0" shininess="1" specular="0.4"/>
    <mesh name="optical_table-model_0" file="model/model_0.obj"/>
    <mesh name="optical_table-model_1" file="model/model_1.obj"/>
    <mesh name="optical_table-model_2" file="model/model_2.obj"/>
    <mesh name="optical_table-model_3" file="model/model_3.obj"/>
    <mesh name="optical_table-model_4" file="model/model_4.obj"/>
    <mesh name="optical_table-model_5" file="model/model_5.obj"/>
    <mesh name="optical_table-model_6" file="model/model_6.obj"/>
    <mesh name="optical_table-model_7" file="model/model_7.obj"/>
    <mesh name="optical_table-model_8" file="model/model_8.obj"/>
    <mesh name="optical_table-model_9" file="model/model_9.obj"/>
    <mesh name="optical_table-model_10" file="model/model_10.obj"/>
    <mesh name="optical_table-model_11" file="model/model_11.obj"/>
    <mesh name="optical_table-model_12" file="model/model_12.obj"/>
    <mesh name="optical_table-model_13" file="model/model_13.obj"/>
    <texture type="2d" name="teddy-bear-texture" file="teddy_bear/texture.png"/>
    <material name="teddy-bear-material" texture="teddy-bear-texture" specular="0.2" shininess="0.2"/>
    <mesh name="teddy-bear-model" file="teddy_bear/model.obj" scale="0.1 0.1 0.1">
      <plugin instance="sdf"/>
    </mesh>
    <texture type="2d" name="mug-tree-texture" file="mug_tree/texture.png"/>
    <material name="mug-tree-material" texture="mug-tree-texture" specular="0.2" shininess="0.2"/>
    <mesh name="mug-tree-model" file="mug_tree/model.obj" scale="0.1 0.1 0.1">
      <plugin instance="sdf"/>
    </mesh>
  </asset>
  <option timestep="0.002" integrator="implicitfast" sdf_iterations="20" sdf_initpoints="40"/>
  <extension>
    <plugin plugin="mujoco.sdf.sdflib">
      <instance name="sdf">
        <config key="aabb" value="0"/>
      </instance>
    </plugin>
  </extension>
  <worldbody>
    <light name="key" pos="1 0.5 1.29" dir="-1 -0.5 -0.5" cutoff="45" diffuse="0.3 0.3 0.3" directional="true"/>
    <light name="fill" pos="0.8 -0.7 1.19" dir="-0.8 0.5 -0.6" cutoff="60" diffuse="0.18 0.18 0.18" directional="true"/>
    <light name="back" pos="-0.8 0 1.99" dir="-1 0 1" cutoff="50" diffuse="0.5 0.5 0.5" directional="true"/>
    <body name="optical_table" pos="0 0 0.79">
      <!--<freejoint/>-->
      <geom mesh="optical_table-model_0" class="optical_table-visual" material="optical_table-mat_1"/>
      <geom mesh="optical_table-model_1" class="optical_table-visual" material="optical_table-mat_2"/>
      <geom mesh="optical_table-model_2" class="optical_table-visual" material="optical_table-mat_3"/>
      <geom mesh="optical_table-model_3" class="optical_table-visual" material="optical_table-mat_4"/>
      <geom mesh="optical_table-model_4" class="optical_table-visual" material="optical_table-mat_5"/>
      <geom mesh="optical_table-model_5" class="optical_table-visual" material="optical_table-mat_6"/>
      <geom mesh="optical_table-model_6" class="optical_table-visual" material="optical_table-mat_7"/>
      <geom mesh="optical_table-model_7" class="optical_table-visual" material="optical_table-mat_8"/>
      <geom mesh="optical_table-model_8" class="optical_table-visual" material="optical_table-mat_9"/>
      <geom mesh="optical_table-model_9" class="optical_table-visual" material="optical_table-mat_10"/>
      <geom mesh="optical_table-model_10" class="optical_table-visual" material="optical_table-mat_11"/>
      <geom mesh="optical_table-model_11" class="optical_table-visual" material="optical_table-mat_12"/>
      <geom mesh="optical_table-model_12" class="optical_table-visual" material="optical_table-mat_13"/>
      <geom mesh="optical_table-model_13" class="optical_table-visual" material="optical_table-mat_14"/>
    </body>
    <body name="teddy-bear" quat="0 0.707 0.707 0" pos="0.2 0.2 0.9">
      <joint type="free"/>
      <geom type="sdf" mesh="teddy-bear-model" material="teddy-bear-material" contype="1" conaffinity="1">
        <plugin instance="sdf"/>
      </geom>
    </body>
    <body name="mug-tree" quat="0 0.707 0.707 0" pos="0.2 0.3 0.9">
      <joint type="free"/>
      <geom type="sdf" mesh="mug-tree-model" material="mug-tree-material" contype="1" conaffinity="1">
        <plugin instance="sdf"/>
      </geom>
    </body>
  </worldbody>
</mujoco>