    <exclude body1="left-gripper-base" body2="left-gripper-right_driver"/>
    <exclude body1="left-gripper-base" body2="left-gripper-left_spring_link"/>
    <exclude body1="left-gripper-base" body2="left-gripper-right_spring_link"/>
    <exclude body1="left-gripper-right_coupler" body2="left-gripper-right_follower"/>
    <exclude body1="left-gripper-left_coupler" body2="left-gripper-left_follower"/>
  </contact>
  <!--This adds stability to the model by having a tendon that distributes the forces between both
      joints, such that the equality constraint doesn't have to do that much work in order to equalize
      both joints. Since both joints share the same sign, we split the force between both equally by
      setting coef=0.5-->
  <tendon>
    <fixed name="left-gripper-split">
      <joint joint="left-gripper-right_driver_joint" coef="0.5"/>
      <joint joint="left-gripper-left_driver_joint" coef="0.5"/>
    </fixed>
  </tendon>
  <equality>
    <connect anchor="0 0 0" body1="left-gripper-right_follower" body2="left-gripper-right_coupler" solimp="0.95 0.99 0.001" solref="0.005 1"/>
    <connect anchor="0 0 0" body1="left-gripper-left_follower" body2="left-gripper-left_coupler" solimp="0.95 0.99 0.001" solref="0.005 1"/>
    <joint joint1="left-gripper-right_driver_joint" joint2="left-gripper-left_driver_joint" polycoef="0 1 0 0 0" solimp="0.95 0.99 0.001" solref="0.005 1"/>
    <weld name="left-gripper-control" site1="left-gripper-mocap-site" site2="left-gripper-pinch"/>
  </equality>
  <!--The general actuator below is a customized position actuator (with some damping) where
      gainprm[0] != kp (see http://mujoco.org/book/modeling.html#position).
      The reason why gainprm[0] != kp is because the control input range has to be re-scaled to
      [0, 255]. The joint range is currently set at [0, 0.8], the control range is [0, 255] and
      kp = 100. Tau = Kp * scale * control_input - Kp * error, max(Kp * scale * control_input) = 0.8,
      hence scale = 0.8 * 100 / 255-->
  <actuator>
    <general class="2f85" name="left-gripper-fingers_actuator" tendon="left-gripper-split" forcerange="-5 5" ctrlrange="0 255" gainprm="0.3137255 0 0" biasprm="0 -100 -10"/>
  </actuator>
</mujoco>